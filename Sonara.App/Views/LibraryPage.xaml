<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Sonara.App.Views"
             xmlns:local="clr-namespace:Sonara.App"
             x:Class="Sonara.App.LibraryPage"
             Title="Библиотека">

    <ContentPage.Resources>
        <local:DurationConverter x:Key="DurationConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="12"
          RowSpacing="8">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">

            <SearchBar Grid.Column="0"
                       Placeholder="Поиск"
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}" />

            <Picker Grid.Column="1"
                    WidthRequest="200"
                    VerticalOptions="Center"
                    Title="Сортировка"
                    ItemsSource="{Binding SortOptions}"
                    SelectedIndex="{Binding SelectedSortIndex}" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Tracks}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto"
                          Padding="0,6,24,6">

                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Title}"
                                   FontSize="16" />
                            <Label Text="{Binding Album}"
                                   FontSize="12"
                                   TextColor="Gray" />
                            <Label Text="{Binding Artist}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="Gray"
                               Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <views:PlayerPanel x:Name="PlayerPanel"
                           Grid.Row="2" />

    </Grid>
</ContentPage>